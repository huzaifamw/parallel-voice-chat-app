{
  "expo": {
    "name": "Parallel",
    "slug": "circle-prototype",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/parallel-icon.png",
    "scheme": "circlechat",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow Parallel to use your microphone in voice rooms."
      },
      "bitcode": false
    },
    "android": {
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#080C10",
        "foregroundImage": "./assets/images/parallel-mark.png",
        "monochromeImage": "./assets/images/parallel-mark.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.huzaifamw.circleprototype"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/parallel-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080C10",
          "image": "./assets/images/parallel-mark.png",
          "imageWidth": 110
        }
      ],
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          },
          "ios": {
            "enableMultitaskingCameraAccess": false
          }
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Allow Parallel to use your microphone in voice rooms."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
