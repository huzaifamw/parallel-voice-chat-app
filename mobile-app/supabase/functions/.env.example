# Use the same values configured in infrastructure/livekit/.env.
LIVEKIT_URL=ws://192.168.1.10:7880
LIVEKIT_API_KEY=replace-with-a-random-api-key
LIVEKIT_API_SECRET=replace-with-a-long-random-secret

# Only needed when your Supabase runtime does not inject its project keys.
APP_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
APP_SUPABASE_SECRET_KEY=sb_secret_replace_me
